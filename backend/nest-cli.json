{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "filenames": ["src", "shared"],
        "stripLeadingPaths": false,
        "ignore": ["**/*.spec.ts"]
      }
    }
  }
}
