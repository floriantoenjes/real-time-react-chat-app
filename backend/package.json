{
    "name": "real-time-chat-backend",
    "version": "0.0.1",
    "description": "<p align=\"center\">   <a href=\"http://nestjs.com/\" target=\"blank\"><img src=\"https://nestjs.com/img/logo-small.svg\" width=\"200\" alt=\"Nest Logo\" /></a> </p>",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1152.0",
        "@keyv/redis": "^5.1.6",
        "@nestjs/cache-manager": "^3.1.3",
        "@nestjs/common": "^11.2.7",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.7",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mongoose": "^11.0.4",
        "@nestjs/platform-express": "^11.2.7",
        "@nestjs/platform-socket.io": "^11.2.7",
        "@nestjs/serve-static": "^5.0.5",
        "@nestjs/throttler": "^6.7.1",
        "@nestjs/websockets": "^11.2.7",
        "@sentry/nestjs": "^10.76.2",
        "@sentry/node": "^10.76.2",
        "@sentry/profiling-node": "^10.76.2",
        "@socket.io/redis-adapter": "^8.3.0",
        "@ts-rest/core": "^3.52.1",
        "@ts-rest/nest": "^3.52.1",
        "bcrypt": "^6.0.0",
        "cache-manager": "^7.2.9",
        "cookie": "^1.1.1",
        "cookie-parser": "^1.4.7",
        "jimp": "^1.6.1",
        "mongoose": "9.11.2",
        "peer": "file:libs/peer/peer-1.0.6.tgz",
        "redis": "^6.3.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.4",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.7",
        "@suites/di.nestjs": "^3.1.0",
        "@suites/doubles.jest": "^3.1.0",
        "@suites/unit": "^3.1.1",
        "@swc/cli": "^0.7.10",
        "@swc/core": "^1.16.20",
        "@swc/jest": "^0.2.39",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie": "^0.6.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.3.0",
        "@types/node": "^24.19.2",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.10",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "@swc/jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "main": "./dist/src/main.js",
    "types": "./dist/src/main.d.ts",
    "directories": {
        "test": "test"
    }
}
